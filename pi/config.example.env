# ha-sms-bridge runtime config. Copy to /opt/ha-sms-bridge/config.env, then:
#   chown root:gammu /opt/ha-sms-bridge/config.env && chmod 640 /opt/ha-sms-bridge/config.env
# NOT 600 root:root. The gammu-smsd receive hook SOURCES this file, and gammu-smsd runs as
# user `gammu` on a standard install -- root-only permissions make inbound fail silently.
# Holds the MQTT password + shared secret -> keep out of git (this .example has none).
MQTT_HOST=homeassistant.local
MQTT_PORT=1883
MQTT_USER=sms-bridge
MQTT_PASS=CHANGE_ME

TOPIC_SEND=clouds/sms/send
TOPIC_INBOUND=clouds/sms/inbound
TOPIC_RESULT=clouds/sms/send/result
TOPIC_STATUS=clouds/sms/bridge/status

# Shared secret: every send payload must include {"token":"..."} equal to this.
# NOT a substitute for broker authentication: it is a bearer token sent in cleartext inside the
# payload, so anything that can SUBSCRIBE to the send topic can capture and replay it. It only
# stops a client that can publish blindly. See 'Securing the broker' in the README.
# Generate: openssl rand -hex 16
SHARED_SECRET=CHANGE_ME

# Send wrapper (injects into the gammu-smsd spool):
WRAPPER_PATH=/opt/ha-sms-bridge/send_sms_wrapper.py
# 0 = call the wrapper directly; 1 = call it via `sudo -n`.
# Leave this at 0. Running the bridge as an unprivileged user does NOT need sudo: put that
# user in group gammu and it can write the spool directly (see "Run the bridge unprivileged"
# in the README). Set 1 only if your gammu install has a spool that is not group-writable --
# and note that it forces NoNewPrivileges off in the unit, which is a real downgrade.
WRAPPER_SUDO=0

# Cost / abuse controls -------------------------------------------------------
MAX_MESSAGE_LEN=160        # one GSM-7 segment; raise only after verifying multipart
RATE_MAX=10                # billed segments per RATE_WINDOW_SEC (sliding window)
RATE_WINDOW_SEC=3600
DAILY_MAX=30               # absolute segments/day, PERSISTED across restarts/reboots
STATE_FILE=/var/lib/ha-sms-bridge/rate.json
INJECT_TIMEOUT=15
MQTT_KEEPALIVE=120
# Recipient allow-list (semicolon-separated). DEFAULT-DENY: an empty list with
# ALLOW_ANY=0 refuses ALL sends. Put your own number(s) here.
ALLOWLIST=
ALLOW_ANY=0

# Diagnostics ----------------------------------------------------------------
# DEBUG_ENV=1   # inbound hook only: dump SMS_*/DECODED_* env vars to stderr on the first receive test
#
# NOTE: this file is read TWO ways — as a systemd EnvironmentFile (outbound service) AND shell-sourced
# by run_on_receive.sh (inbound). Keep every value free of spaces / quotes / $ so both parsers agree
# (matters most for MQTT_PASS and SHARED_SECRET). `openssl rand -hex 16` is safe by construction.
